# ===== 后端环境变量示例 =====
# 复制为 .env 后按需修改；生产环境请务必替换所有 change-me 占位值。

# 鉴权密钥（JWT / 二维码 / 导出水印共用），生产环境请改为足够长的随机串
SECRET_KEY=change-me-to-a-long-random-string

# 敏感字段 AES-256-GCM 加密密钥。注意：一旦变更，已加密的历史数据将无法解密
DATA_ENCRYPTION_KEY=change-me-to-another-long-random-string

# 允许跨域访问的前端地址（多个用英文逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 二维码扫码落地页基地址（部署后填前端公网地址）
PUBLIC_BASE_URL=http://127.0.0.1:5173

# 可选：配置 DeepSeek API Key 后，AI 助手走大模型；留空则使用内置规则引擎
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat